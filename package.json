{
  "name": "roundtable",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "start": "concurrently -k -n hub,web -c cyan,magenta \"tsx server/index.ts\" \"vite --open\"",
    "dev": "concurrently -k -n hub,web -c cyan,magenta \"tsx server/index.ts\" \"vite\"",
    "test": "vitest run",
    "e2e": "playwright test",
    "room": "tsx scripts/room.ts",
    "sheet": "tsx scripts/sheet.ts",
    "room:bless": "tsx scripts/bless.ts"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.4",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
